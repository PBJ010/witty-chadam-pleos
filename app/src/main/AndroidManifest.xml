<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NaviHelper (normal permissions, no approval gate) and the Vehicle SDK's readings (battery, range). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <!-- The car's position without the navigation (FusedLocation SDK; a runtime permission, asked in MainActivity). -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- The car's own voice (TextToSpeech SDK, on the device; a normal permission). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- The car's speech recognition (SpeechToText SDK, on the device) and the microphone it listens with. -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The car's make and model through the standard Car API (a normal permission on AAOS). -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        android:supportsRtl="false">
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
